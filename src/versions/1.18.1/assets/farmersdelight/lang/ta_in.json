  "farmersdelight.advancement.eat_nourishing_food.desc": "ஒரு இதயம் நிறைந்த உணவு உங்களை நீண்ட நேரம் ஊட்டமளிக்கும்!",
  "farmersdelight.advancement.get_ham": "காட்டு கசாப்புக்காரன்",
  "farmersdelight.advancement.get_ham.desc": "பன்றிகளிடமிருந்து பெரிய வெட்டு இறைச்சியைப் பிரித்தெடுக்க கத்தியைப் பயன்படுத்தவும்",
  "farmersdelight.advancement.get_mushroom_colony": "நம்மிடையே பூஞ்சை",
  "farmersdelight.advancement.get_mushroom_colony.desc": "இருண்ட மண்ணில் காளான்களை நடவும், ஒரு காலனி வடிவத்தைப் பார்க்கவும், பின்னர் அதை வெட்டவும்!",
  "farmersdelight.advancement.get_rich_soil": "தாவர உணவு",
  "farmersdelight.advancement.get_rich_soil.desc": "அது வளமான மண்ணாக மாறும் வரை சிதைவதற்கு சில கரிம உரங்களை விட்டு விடுங்கள். காளான்கள் உதவக்கூடும்!",
  "farmersdelight.advancement.harvest_straw": "ஸ்ட்ராஸில் பிடிப்பது",
  "farmersdelight.advancement.harvest_straw.desc": "வைக்கோலைப் பெறுவதற்கு புல் செடிகள் மற்றும் பயிர்களை கத்தியால் அறுவடை செய்யவும்",
  "farmersdelight.advancement.master_chef": "மாஸ்டர் செஃப்",
  "farmersdelight.advancement.master_chef.desc": "கிடைக்கும் ஒவ்வொரு உணவின் போக்கையும் சாப்பிடுங்கள்!",
  "farmersdelight.advancement.obtain_netherite_knife": "நீங்கள் வெப்பத்தை எடுக்க முடியாவிட்டால் ...",
  "farmersdelight.advancement.obtain_netherite_knife.desc": "உங்கள் கத்தியை மேம்படுத்த முழு Netherite Ingot ஐ செலவிடுங்கள்! அல்லது சமையலறையை விட்டு வெளியேறவும்.",
  "farmersdelight.advancement.place_campfire": "நெருப்பு எரிகிறது",
  "farmersdelight.advancement.place_campfire.desc": "இரவில் உங்களை சூடாக வைத்திருக்க ஒரு கேம்ப்ஃபயர் கீழே வைக்கவும்",
  "farmersdelight.advancement.place_cooking_pot": "இரவு உணவு பரிமாறப்பட்டது!",
  "farmersdelight.advancement.place_cooking_pot.desc": "ஒரு சமையல் பானையை கீழே வைத்து, உணவைத் தயாரிக்கத் தொடங்குங்கள்!",
  "farmersdelight.advancement.place_feast": "ஒரு புகழ்பெற்ற விருந்து",
  "farmersdelight.advancement.place_feast.desc": "நண்பர்களுடன் பகிர்ந்து கொள்வதற்காக சில உணவுகள் மேசையில் சிறந்த முறையில் வழங்கப்படுகின்றன. உங்கள் கிண்ணங்களை தயார் செய்யுங்கள்!",
  "farmersdelight.advancement.place_skillet": "சிஸ்லிங் ஹாட்!",
  "farmersdelight.advancement.place_skillet.desc": "பதுங்கியிருக்கும் போது உங்கள் ஸ்கில்லெட்டை ஒரு பிளாக்காக வைக்கவும்",
