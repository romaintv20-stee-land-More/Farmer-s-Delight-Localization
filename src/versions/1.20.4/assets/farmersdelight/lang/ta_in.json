  "effect.farmersdelight.nourishment.0.desc": "சேதத்தை குணப்படுத்த செறிவூட்டலைப் பயன்படுத்துவதைத் தவிர, பசி இழப்பைத் தடுக்கிறது.",
  "enchantment.farmersdelight.backstabbing": "முதுகில் குத்துதல்",
  "enchantment.farmersdelight.backstabbing.desc": "பின்னால் இருந்து இலக்கைத் தாக்கும் போது சேதத்தை அதிகரிக்கிறது.",
  "entity.farmersdelight.rotten_tomato": "அழுகிய தக்காளி",
  "farmersdelight.advancement.craft_knife": "வேட்டையாடி சேகரிக்கவும்",
  "farmersdelight.advancement.craft_knife.desc": "தாவரங்கள் மற்றும் விலங்குகளிடமிருந்து கூடுதல் பொருட்களைத் துடைக்க ஒரு கத்தியை உருவாக்கவும்",
  "farmersdelight.advancement.eat_comfort_food": "ஆறுதல்!",
  "farmersdelight.advancement.eat_comfort_food.desc": "நீங்கள் எவ்வளவு பசியாக இருந்தாலும், சூடான கிண்ண உணவுகள் உங்களை சீராக குணப்படுத்தும்!",
  "farmersdelight.advancement.eat_nourishing_food": "ஊட்டமளிக்கும்!",
  "farmersdelight.advancement.eat_nourishing_food.desc": "பூசப்பட்ட உணவுகள் உங்களை சிறிது நேரம் சோர்வடையவோ அல்லது பசியாகவோ தடுக்கும்!",
  "farmersdelight.advancement.get_fd_seed": "காட்டுப் பயிர்கள்",
  "farmersdelight.advancement.get_fd_seed.desc": "நான்கு புதிய பயிர்கள் காடுகளில், பல தட்பவெப்ப நிலைகளில் காணப்படலாம்... அல்லது எங்காவது ஒரு மார்பில் இருக்கலாம்.",
  "farmersdelight.advancement.get_ham": "காட்டு கசாப்புக்காரன்",
  "farmersdelight.advancement.get_ham.desc": "பன்றிகள் அல்லது ஹாக்லின்களில் இருந்து ஹாம் பிரித்தெடுக்க ஒரு கத்தியைப் பயன்படுத்தவும்",
  "farmersdelight.advancement.get_mushroom_colony": "நம்மிடையே பூஞ்சை",
  "farmersdelight.advancement.get_mushroom_colony.desc": "முழு முதிர்ந்த காளான் காலனியை வெட்டுங்கள். இப்படி வளர்க்க, வளமான மண் வேண்டும்.",
  "farmersdelight.advancement.get_rich_soil": "தாவர உணவு",
  "farmersdelight.advancement.get_rich_soil.desc": "கரிம உரம் மெதுவாக செழுமையான மண்ணாக சிதைகிறது, இது உங்கள் பண்ணைகளுக்கான மேம்படுத்தல்!",
  "farmersdelight.advancement.harvest_ropelogged_tomato": "உயரமான-மாட்டோ",
  "farmersdelight.advancement.harvest_ropelogged_tomato.desc": "தக்காளிப் பயிர் உயரமாக வளர அதன் மேல் சில கயிறுகளை மாட்டி வைக்கவும்",
  "farmersdelight.advancement.harvest_straw": "ஸ்ட்ராஸில் பிடிப்பது",
  "farmersdelight.advancement.harvest_straw.desc": "வைக்கோல் சேகரிக்க புல், கோதுமை அல்லது அரிசியை கத்தியால் அறுவடை செய்யவும்",
  "farmersdelight.advancement.hit_raider_with_rotten_tomato": "பூ! ஹிஸ்!",
  "farmersdelight.advancement.hit_raider_with_rotten_tomato.desc": "இந்த தொல்லைதரும் ரைடர்களில் ஒருவருக்கு அழுகிய தக்காளியை எறியுங்கள்!",
  "farmersdelight.advancement.master_chef": "மாஸ்டர் செஃப்",
  "farmersdelight.advancement.master_chef.desc": "கிடைக்கும் ஒவ்வொரு உணவின் போக்கையும் சாப்பிடுங்கள்!",
  "farmersdelight.advancement.obtain_netherite_knife": "நீங்கள் வெப்பத்தை எடுக்க முடியாவிட்டால் ...",
  "farmersdelight.advancement.obtain_netherite_knife.desc": "உங்கள் கத்தியை மேம்படுத்த முழு Netherite Ingot ஐ செலவிடுங்கள்! அல்லது சமையலறையை விட்டு வெளியேறவும்.",
  "farmersdelight.advancement.place_campfire": "நெருப்பு எரிகிறது",
  "farmersdelight.advancement.place_campfire.desc": "சிறிது உணவு சமைக்க ஒரு கேம்ப்ஃபயர் கீழே வைக்கவும்",
  "farmersdelight.advancement.place_cooking_pot": "இரவு உணவு பரிமாறப்பட்டது!",
  "farmersdelight.advancement.place_cooking_pot.desc": "ஒரு சமையல் பானையை கீழே வைத்து, உணவைத் தயாரிக்கத் தொடங்குங்கள்!",
  "farmersdelight.advancement.place_feast": "ஒரு புகழ்பெற்ற விருந்து",
  "farmersdelight.advancement.place_feast.desc": "சில உணவுகள் கீழே வைக்கப்பட்டு நண்பர்களுடன் பகிர்ந்து கொள்ளும் அளவுக்கு பெரியதாக இருக்கும்!",
  "farmersdelight.advancement.place_organic_compost": "மேம்பட்ட உரமாக்கல்",
