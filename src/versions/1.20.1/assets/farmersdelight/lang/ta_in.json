{
  "advancements.farmersdelight.craft_knife.description": "தாவரங்கள் மற்றும் விலங்குகளிடமிருந்து கூடுதல் பொருட்களைத் துடைக்க ஒரு கத்தியை உருவாக்கவும்",
  "advancements.farmersdelight.craft_knife.title": "வேட்டையாடி சேகரிக்கவும்",
  "advancements.farmersdelight.eat_nourishing_food.description": "ஒரு சீரான மற்றும் மாறுபட்ட உணவு உங்களை நீண்ட காலத்திற்கு உணவாகவும் ஆரோக்கியமாகவும் வைத்திருக்கும்!",
  "advancements.farmersdelight.eat_nourishing_food.title": "ஊட்டமளிக்கும்!",
  "advancements.farmersdelight.get_fd_seed.description": "நான்கு புதிய பயிர்கள் காடுகளில், பல தட்பவெப்ப நிலைகளில் காணப்படலாம்... அல்லது எங்காவது ஒரு மார்பில் இருக்கலாம்.",
  "advancements.farmersdelight.get_fd_seed.title": "காட்டுப் பயிர்கள்",
  "advancements.farmersdelight.get_ham.description": "பன்றிகள் அல்லது ஹாக்லின்களில் இருந்து ஹாம் பிரித்தெடுக்க ஒரு கத்தியைப் பயன்படுத்தவும்",
  "advancements.farmersdelight.get_ham.title": "காட்டு கசாப்புக்காரன்",
  "advancements.farmersdelight.get_mushroom_colony.description": "முழு முதிர்ந்த காளான் காலனியை வெட்டுங்கள். இப்படி வளர்க்க, வளமான மண் வேண்டும்.",
  "advancements.farmersdelight.get_mushroom_colony.title": "நம்மிடையே பூஞ்சை",
  "advancements.farmersdelight.get_rich_soil.description": "கரிம உரம் மெதுவாக செழுமையான மண்ணாக சிதைகிறது, இது உங்கள் பண்ணைகளுக்கான மேம்படுத்தல்!",
  "advancements.farmersdelight.get_rich_soil.title": "தாவர உணவு",
  "advancements.farmersdelight.harvest_ropelogged_tomato.description": "தக்காளிப் பயிர் உயரமாக வளர அதன் மேல் சில கயிறுகளை மாட்டி வைக்கவும்",
  "advancements.farmersdelight.harvest_ropelogged_tomato.title": "உயரமான-மாட்டோ",
  "advancements.farmersdelight.harvest_straw.description": "வைக்கோல் சேகரிக்க புல், கோதுமை அல்லது அரிசியை கத்தியால் அறுவடை செய்யவும்",
  "advancements.farmersdelight.harvest_straw.title": "ஸ்ட்ராஸில் பிடிப்பது",
  "advancements.farmersdelight.hit_raider_with_rotten_tomato.description": "இந்த தொல்லைதரும் ரைடர்களில் ஒருவருக்கு அழுகிய தக்காளியை எறியுங்கள்!",
  "advancements.farmersdelight.hit_raider_with_rotten_tomato.title": "பூ! ஹிஸ்!",
  "advancements.farmersdelight.master_chef.description": "கிடைக்கும் ஒவ்வொரு உணவின் போக்கையும் சாப்பிடுங்கள்!",
  "advancements.farmersdelight.master_chef.title": "மாஸ்டர் செஃப்",
  "advancements.farmersdelight.obtain_netherite_knife.description": "உங்கள் கத்தியை மேம்படுத்த முழு Netherite Ingot ஐ செலவிடுங்கள்! அல்லது சமையலறையை விட்டு வெளியேறவும்.",
  "advancements.farmersdelight.obtain_netherite_knife.title": "நீங்கள் வெப்பத்தை எடுக்க முடியாவிட்டால் ...",
  "advancements.farmersdelight.place_campfire.description": "சிறிது உணவு சமைக்க ஒரு கேம்ப்ஃபயர் கீழே வைக்கவும்",
  "advancements.farmersdelight.place_campfire.title": "நெருப்பு எரிகிறது",
  "advancements.farmersdelight.place_cooking_pot.description": "ஒரு சமையல் பானையை கீழே வைத்து, உணவைத் தயாரிக்கத் தொடங்குங்கள்!",
  "advancements.farmersdelight.place_cooking_pot.title": "இரவு உணவு பரிமாறப்பட்டது!",
  "advancements.farmersdelight.place_feast.description": "சில உணவுகள் கீழே வைக்கப்பட்டு நண்பர்களுடன் பகிர்ந்து கொள்ளும் அளவுக்கு பெரியதாக இருக்கும்!",
  "advancements.farmersdelight.place_feast.title": "ஒரு புகழ்பெற்ற விருந்து",
  "advancements.farmersdelight.place_organic_compost.description": "சில கரிம உரங்களை கீழே வைக்கவும். இது சூரியன், தண்ணீர் மற்றும் காளான்களுடன் சிறப்பாக உரமாக்குகிறது!",
  "advancements.farmersdelight.place_organic_compost.title": "மேம்பட்ட உரமாக்கல்",
  "advancements.farmersdelight.place_skillet.description": "உங்கள் ஸ்கில்லெட்டை ஒரு பிளாக்காக வைக்க பதுங்கிச் செல்லவும்",
  "advancements.farmersdelight.place_skillet.title": "சிஸ்லிங் ஹாட்!",
  "advancements.farmersdelight.plant_all_crops.description": "காய்கறிகள், பழங்கள், பூஞ்சைகள் அல்லது வேர்கள் போன்ற நீங்கள் காணக்கூடிய உணவு தொடர்பான ஒவ்வொரு தாவரத்தையும் பயிரிடுங்கள்!",
  "advancements.farmersdelight.plant_all_crops.title": "பயிர் சுழற்சி",
  "advancements.farmersdelight.plant_rice.description": "ஒரு ஆழமற்ற நீர் குட்டையில் அரிசி தானியங்களை நடவும்",
  "advancements.farmersdelight.plant_rice.title": "உங்கள் வேர்களை நனைத்தல்",
  "advancements.farmersdelight.root.description": "ஒரு சுவை உலகம் உங்களுக்கு காத்திருக்கிறது!",
  "advancements.farmersdelight.root.title": "விவசாயியின் மகிழ்ச்சி",
  "advancements.farmersdelight.use_cutting_board.description": "கையில் ஒரு கருவியுடன், ஒரு பொருளை உடைக்க ஒரு கட்டிங் போர்டைப் பயன்படுத்தவும்",
  "advancements.farmersdelight.use_cutting_board.title": "உங்கள் விரல்களைப் பாருங்கள்",
  "advancements.farmersdelight.use_skillet.description": "திறமைகள் பயணத்தின்போது சமைக்க அனுமதிக்கின்றன. வெப்பத்திற்கு அருகில் நிற்கவும், பின்னர் உணவை உங்கள் மறு கையில் பிடித்துக் கொள்ளவும்!",
