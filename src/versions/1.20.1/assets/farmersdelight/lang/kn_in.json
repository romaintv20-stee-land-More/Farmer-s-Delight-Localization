  "jei.farmersdelight.info.dough": "ಗೋಧಿಯನ್ನು ನೀರಿನ ಬಕೆಟ್‌ನಿಂದ ತಯಾರಿಸುವ ಮೂಲಕ ಹಿಟ್ಟಾಗಿ ಪರಿವರ್ತಿಸಬಹುದು.ಆದರೆ ಚಿಂತಿಸಬೇಡಿ, ಬಕೆಟ್‌ನ ನೀರು ಖಾಲಿಯಾಗುವುದಿಲ್ಲ!",
  "jei.farmersdelight.info.ham": "ಹಂದಿ ಅಥವಾ ಹಾಗ್ಲಿನ್ ಕಾಲಿನಿಂದ ಮಾಂಸದ ದೊಡ್ಡ ಕಟ್.\n\nಒಂದನ್ನು ಕತ್ತರಿಸಲು ನಿಮಗೆ ಕತ್ತಿಗಿಂತ ಹಗುರವಾದ ಏನಾದರೂ ಬೇಕಾಗುತ್ತದೆ ...",
  "jei.farmersdelight.info.knife": "ವೇಗದ ಸ್ವಿಂಗ್‌ಗಳು ಮತ್ತು ಸೌಮ್ಯವಾದ ಹಾನಿಯೊಂದಿಗೆ ಹಗುರವಾದ ಗಲಿಬಿಲಿ ಶಸ್ತ್ರಾಸ್ತ್ರ.\n\nಅವರು ಹುಲ್ಲುಗಳಿಂದ ಒಣಹುಲ್ಲಿನ ಕೊಯ್ಲು ಮಾಡಬಹುದು ಮತ್ತು ಪ್ರಾಣಿಗಳಿಂದ ದ್ವಿತೀಯ ಹನಿಗಳನ್ನು ಖಾತರಿಪಡಿಸಬಹುದು.",
  "jei.farmersdelight.info.straw": "ಕರಕುಶಲ ತಯಾರಿಕೆಯಲ್ಲಿ ಬಳಸುವ ಒಣ ಸಸ್ಯ ನಾರು. ಹುಲ್ಲಿನ ಬೆಳೆಗಳು ಮತ್ತು ಸಸ್ಯಗಳನ್ನು ಚಾಕುವಿನಿಂದ ಕತ್ತರಿಸುವ ಮೂಲಕ ಪಡೆಯಲಾಗುತ್ತದೆ.",
  "jei.farmersdelight.info.wild_beetroots": "ಬೀಟ್‌ರೂಟ್ ಅನ್ನು ಸಾಮಾನ್ಯವಾಗಿ ಕಡಲತೀರದ ಕರಾವಳಿಯಲ್ಲಿ ಕಾಡು ಸಸ್ಯವಾಗಿ ಕಾಣಬಹುದು.",
  "jei.farmersdelight.info.wild_cabbages": "ಕಡಲತೀರದ ಕರಾವಳಿಯಲ್ಲಿ ಎಲೆಕೋಸುಗಳನ್ನು ಸಾಮಾನ್ಯವಾಗಿ ಕಾಡು ಸಸ್ಯವಾಗಿ ಕಾಣಬಹುದು.",
  "jei.farmersdelight.info.wild_carrots": "ಕ್ಯಾರೆಟ್ ಅನ್ನು ಸಾಮಾನ್ಯವಾಗಿ ಸಮಶೀತೋಷ್ಣ ಭೂಮಿಗಳಲ್ಲಿ, ಬಯಲು ಮತ್ತು ಕಾಡುಗಳಲ್ಲಿ ಕಾಡು ಸಸ್ಯವಾಗಿ ಕಾಣಬಹುದು.",
  "jei.farmersdelight.info.wild_onions": "ಈರುಳ್ಳಿಯನ್ನು ಸಾಮಾನ್ಯವಾಗಿ ಸಮಶೀತೋಷ್ಣ ಭೂಮಿಗಳಾದ ಬಯಲು ಮತ್ತು ಕಾಡುಗಳಲ್ಲಿ ಕಾಡು ಸಸ್ಯವಾಗಿ ಕಾಣಬಹುದು.",
  "jei.farmersdelight.info.wild_potatoes": "ಆಲೂಗಡ್ಡೆಗಳನ್ನು ಸಾಮಾನ್ಯವಾಗಿ ಪರ್ವತಗಳು ಮತ್ತು ಟೈಗಾಸ್‌ನಂತಹ ಶೀತ ಭೂಮಿಯಲ್ಲಿ ಕಾಡು ಸಸ್ಯವಾಗಿ ಕಾಣಬಹುದು.",
  "jei.farmersdelight.info.wild_rice": "ಜೌಗು ಪ್ರದೇಶಗಳು ಮತ್ತು ಕಾಡುಗಳಂತಹ ಆರ್ದ್ರ ಭೂಮಿಗಳ ಕೊಳಗಳಲ್ಲಿ ಭತ್ತವನ್ನು ಸಾಮಾನ್ಯವಾಗಿ ಕಾಡು ಸಸ್ಯವಾಗಿ ಕಾಣಬಹುದು.",
