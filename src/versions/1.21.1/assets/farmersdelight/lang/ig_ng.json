  "farmersdelight.configuration.enableRabbitStewBuff": "Oke bekee stew buff",
  "farmersdelight.configuration.enableRabbitStewBuff.tooltip": "Ọ bụrụ na agbanyere ya, a ga-enye stew Rabbit ka ọ dabara na ọnụ ahịa nka ya.",
  "farmersdelight.configuration.enableRopeReeling": "Ntugharị eriri",
  "farmersdelight.configuration.enableRopeReeling.tooltip": "Ọ bụrụ na agbanyere ya, ndị egwuregwu ga-enwe ike ịnyagharị ụdọ azụ, ala ruo n'elu, mgbe ha na-eji aka efu eme ihe n'ime ha.",
  "farmersdelight.configuration.enableStackableSoupItems": "Ihe ofe nwere ike ikpokọta",
  "farmersdelight.configuration.enableStackableSoupItems.tooltip": "Ọ bụrụ na agbanyere ya, ihe ọ bụla BowlFoodItem dị na ndepụta ndị a ga-abụ nke a ga-anakọta ruo 16, dị ka nri ndị ọrụ ugbo.",
  "farmersdelight.configuration.enableTomatoRopePermanence": "Ụdọ Tomato adịgide",
  "farmersdelight.configuration.enableTomatoRopePermanence.tooltip": "Ihe ọkụkụ tomato nke kwụgidere n'ụdọ ga-amanye ebe mgbochi eriri mgbe agbajiri ya.N'ihi oke teknụzụ, nke a na-emetụta ihe dịka iwu, na-eme ka ha ghara 'igbochi' ngọngọ a na mbọ mbụ.\n\nGbanyụọ nke a ma ọ bụrụ na ngọngọ a na-egbochi gị idezi mpaghara na okike ma ọ bụ iwu.Maka egwuregwu nkịtị, ana m akwado ịhapụ nke a ka agbanyere ya.",
  "farmersdelight.configuration.enableTomatoVineClimbingTaggedRopes": "Tomato Vine Climbs Tagged Ropes",
  "farmersdelight.configuration.enableTomatoVineClimbingTaggedRopes.tooltip": "Ọ bụrụ na enyere ya aka, ihe ọkụkụ tomato ga-enwe ike ịrị eriri ọ bụla akpọrọ dị ka ndị ọrụ ugbo na-atọ ụtọ: ụdọ.Ọ bụrụ na ọ nwere nkwarụ, a ga-amachibido nke a na naanị eriri mod a.\n\n§lLezienụ anya: nke a ga-atụgharị ihe mgbochi ndị a ka ọ bụrụ ngọngọ akọwapụtara na ndabaraTomatoVineRope.§r",
  "farmersdelight.configuration.enableVanillaCropCrates": "Vanilla Crop Crates",
  "farmersdelight.configuration.enableVanillaCropCrates.tooltip": "Ọ bụrụ na agbanyere ya, igbe nchekwa (3x3) maka ihe ọkụkụ vanilla (dị ka Quark na Thermal Cultivation) ga-abụ nke a na-emepụta ihe.",
  "farmersdelight.configuration.enableVanillaSoupExtraEffects": "Vanilla Soup Extra Effects",
  "farmersdelight.configuration.enableVanillaSoupExtraEffects.tooltip": "Ọ bụrụ na enyere ya aka, ofe na stews sitere na Minecraft ga-enye nri mgbe a na-eri ya, dịka nri sitere na mod a.",
  "farmersdelight.configuration.enableWanderingTraderFDTrades": "Special Wandering Trader Trades",
  "farmersdelight.configuration.enableWanderingTraderFDTrades.tooltip": "Ọ bụrụ na enyere ya aka, onye na-ere ahịa Wandering ga-enwe ohere ire mkpụrụ na ihe ọkụkụ sitere na mod a.",
  "farmersdelight.configuration.farming": "Ọrụ ugbo",
  "farmersdelight.configuration.generateFDChestLoot": "Mepụta Mod Chest Loot",
  "farmersdelight.configuration.generateFDChestLoot.tooltip": "Ọ bụrụ na enyere ya aka, a ga-agbakwunye ọdọ mmiri ọhụrụ loot na ngwongwo igbe n'ofe egwuregwu ahụ, nwere ihe sitere na mod a (ụdọ, ihe ọkụkụ, ngwa ọrụ wdg).",
  "farmersdelight.configuration.generateFDCropsOnVillageFarms": "Mepụta mkpụrụ osisi Mod na Ugbo Obodo",
  "farmersdelight.configuration.generateFDCropsOnVillageFarms.tooltip": "Ọ bụrụ na enyere ya aka, ihe ọkụkụ sitere na obi ụtọ nke ndị ọrụ ugbo ga-eji dochie ihe ọkụkụ a na-akụ n'ime ala ubi.",
