  "farmersdelight.configuration.enableNourishmentHungerOverlay": "Overlay ta' Ġuħ ta' Nutriment",
  "farmersdelight.configuration.enableNourishmentHungerOverlay.tooltip": "Jekk ikun attivat, se jintwera overlay indurat fuq il-miter tal-ikel meta l-plejer ikollu l-effett Nutriment.",
  "farmersdelight.configuration.enablePumpkinPieSneakToPlace": "Sneak biex Poġġi Pumpkin Pie",
  "farmersdelight.configuration.enablePumpkinPieSneakToPlace.tooltip": "Jekk tkun attivata, Pumpkin Pie se teħtieġ li l-utent iħeġġu biex ipoġġiha 'l isfel bħala blokka.",
  "farmersdelight.configuration.enableRabbitStewBuff": "Fniek Stew Buff",
  "farmersdelight.configuration.enableRabbitStewBuff.tooltip": "Jekk ikun attivat, Rabbit Stew se jingħata stats mtejba tal-ikel, biex jaqbel mal-ispiża tal-crafting tiegħu.",
  "farmersdelight.configuration.enableRopeReeling": "Tkebbib tal-Ħabel",
  "farmersdelight.configuration.enableRopeReeling.tooltip": "Jekk ikun attivat, il-plejers ikunu jistgħu jmexxu l-ħabel lura, minn isfel għal fuq, meta jużaw b'id vojta fuqhom.",
  "farmersdelight.configuration.enableStackableSoupItems": "Oġġetti tas-Soppa li jistgħu jinstammu",
  "farmersdelight.configuration.enableStackableSoupItems.tooltip": "Jekk ikun attivat, kwalunkwe BowlFoodItem fil-lista li ġejja se jsir stackable għal 16, ħafna bħall-ikliet tal-Fermer's Delight.",
  "farmersdelight.configuration.enableTomatoRopePermanence": "Permanenza Ħabel tat-Tadam",
  "farmersdelight.configuration.enableTomatoRopePermanence.tooltip": "Uċuħ tar-raba 'tadam imdendlin mal-ħabel se jġiegħel blokk Ħabel meta miksur.Minħabba limitazzjonijiet tekniċi, dan jaffettwa affarijiet bħall-kmandi, u jagħmilhom jonqsu milli 'jissettjaw' dan il-blokk mal-ewwel tentattiv.\n\nIddiżattiva dan jekk dan il-blokk qed jipprevjenik milli teditja reġjun b'mod kreattiv jew bi kmandi.Għal gameplay normali, nirrakkomanda li tħalli din attivata.",
  "farmersdelight.configuration.enableTomatoVineClimbingTaggedRopes": "Tadam Vine Climbs Tagged Ħbula",
  "farmersdelight.configuration.enableTomatoVineClimbingTaggedRopes.tooltip": "Jekk ikun attivat, l-uċuħ tar-raba' tat-tadam ikunu jistgħu jitilgħu kull ħabel immarkat bħala farmersdelight:ropes.Jekk b'diżabilità, dan ikun ristrett għall-ħabel ta 'dan mod biss.\n\n§lOqgħod attent: dan se jikkonverti dawn il-blokki fil-blokk speċifikat f'defaultTomatoVineRope.§r",
  "farmersdelight.configuration.enableVanillaCropCrates": "Ċestuni tal-Ħsad tal-Vanilla",
  "farmersdelight.configuration.enableVanillaCropCrates.tooltip": "Jekk ppermettiet, il-kaxex tal-ħażna (3x3) għall-uċuħ tar-raba' tal-vanilla (simili għal Quark u Kultivazzjoni Termali) isiru craftable.",
  "farmersdelight.configuration.enableVanillaSoupExtraEffects": "Soppa tal-vanilla Effetti Extra",
  "farmersdelight.configuration.enableVanillaSoupExtraEffects.tooltip": "Jekk ppermettiet, sopop u stews minn Minecraft se jagħtu Nutriment meta jittieklu, simili għal ikliet minn dan il-mod.",
  "farmersdelight.configuration.enableWanderingTraderFDTrades": "Speċjali Wandering Trader Trades",
  "farmersdelight.configuration.enableWanderingTraderFDTrades.tooltip": "Jekk ppermettiet, in-Negozjant Wandering se jkollu ċ-ċans li jbiegħ żrieragħ u pjanti minn dan il-mod.",
  "farmersdelight.configuration.farming": "Biedja",
  "farmersdelight.configuration.generateFDChestLoot": "Iġġenera Mod Chest Loot",
  "farmersdelight.configuration.generateFDChestLoot.tooltip": "Jekk ikun attivat, loot pools ġodda se jiġu miżjuda mal-loot tas-sider madwar il-logħba, li jkun fihom oġġetti minn dan il-mod (ħbula, uċuħ, għodod eċċ).",
  "farmersdelight.configuration.generateFDCropsOnVillageFarms": "Iġġenera Mod Uċuħ fuq irziezet tal-Villaġġ",
  "farmersdelight.configuration.generateFDCropsOnVillageFarms.tooltip": "Jekk ikun attivat, l-uċuħ tar-raba' minn Farmer's Delight xi drabi jissostitwixxu l-uċuħ tar-raba' standard fil-plottijiet tal-farms tar-raħal.",
  "farmersdelight.configuration.generateVillageCompostHeaps": "Iġġenera Munzelli ta' Kompost tal-Villaġġ",
  "farmersdelight.configuration.generateVillageCompostHeaps.tooltip": "Jekk ikun attivat, Munzelli ta' Kompost (strutturi li fihom munzelli ta' Kompost Organiku) kultant jiġġeneraw madwar l-irħula.",
